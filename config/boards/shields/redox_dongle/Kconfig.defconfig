if SHIELD_REDOX_DONGLE

# Max 16 characters
config ZMK_KEYBOARD_NAME
    default "Redox"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Two halves => 2 peripherals
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# peripherals (2) + BT profiles (5)
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
